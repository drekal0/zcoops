# --- Database (Turso/libSQL) ---
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# --- Wallet backend ---
# mock     -> no chain, fake txids (default; build UI/logic with zero infra)
# zallet   -> your Zebra node + Zallet over RPC (recommended real backend)
# zingolib -> lightwallet client against Zaino (alternative; see README)
WALLET_BACKEND=mock
WALLET_NETWORK=regtest

# --- Zallet RPC (only used when WALLET_BACKEND=zallet) ---
# When your node is synced, flip WALLET_BACKEND=zallet and point these at your
# wallet. Nothing else changes. See docs/wallet-z3.md.
ZALLET_RPC_URL=http://localhost:8232
ZALLET_RPC_USER=
ZALLET_RPC_PASSWORD=

# --- Security ---
HASH_SALT=change-me-to-a-long-random-string
ADMIN_TOKEN=dev-admin-token

# --- Captcha (Cloudflare Turnstile; public pools only) ---
# Leave blank in dev to disable the captcha gate. Set both to enable it.
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITEKEY=
